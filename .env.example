ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=low
QDRANT_HOST=localhost
QDRANT_PORT=6333
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_FILE=credential.json
# Credential/token files below are looked up in ./secrets (override with SECRETS_DIR or an absolute path).
GOOGLE_TOKEN_FILE=token.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_OAUTH_PORT=8080
CALENDAR_TIMEZONE=Asia/Ho_Chi_Minh
GOOGLE_GMAIL_CLIENT_FILE=credential.json
GOOGLE_GMAIL_TOKEN_FILE=gmail_token.json
GOOGLE_GMAIL_OAUTH_PORT=8000
GOOGLE_WEB_CLIENT_FILE=client_secret.json
GOOGLE_WEB_REDIRECT_URI=http://localhost:9004
OTEL_SERVICE_NAME=ai-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Company research workspace (SQLite; no Qdrant needed for company knowledge).
RESEARCH_DB_PATH=.runtime/research.sqlite3
RESEARCH_DEMO_ENABLED=true
RESEARCH_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
RESEARCH_USE_LLM=true
RESEARCH_MAX_PAGES=24
RESEARCH_MAX_SEARCH_QUERIES=10
RESEARCH_MAX_WEBSITE_PAGES=8
RESEARCH_DEADLINE_SECONDS=480
# Search agent that builds the dashboard-style report (Claude + Tavily search/fetch).
# fast: parallel search + specialist extraction (~30-40s); deep: tool-loop agent (slower, more thorough).
RESEARCH_AGENT_MODE=fast
RESEARCH_FAST_MODEL=claude-haiku-5-5
RESEARCH_AGENT_MODEL=claude-sonnet-5-5
RESEARCH_AGENT_SEARCHES=16
RESEARCH_AGENT_FETCHES=14
RESEARCH_COMPANY_TTL_DAYS=7
RESEARCH_APPROVAL_SECONDS=1800
RESEARCH_WORK_START=9
RESEARCH_WORK_END=18

# Login sessions persist across restarts (encrypted under .runtime/). Hours; default 7 days.
LOGIN_SESSION_HOURS=168
# LOGIN_SESSION_KEY=   # optional Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")

# read_file may only read inside these folders (os.pathsep-separated); credentials are always refused.
# READ_FILE_ALLOWED_DIRS=~/Documents:~/Downloads:~/Desktop
MEMORY_TTL_DAYS=90

